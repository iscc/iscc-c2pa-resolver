# ISCC C2PA Resolver configuration. Copy to .env for local development; set as environment variables in deployment.

# iscc-search aggregator to query. Mainnet (default): https://search.iscc.io with index idp.
# Testnet: https://search-test.iscc.id with index idptest.
# ISCC_C2PA_RESOLVER_SEARCH_URL=https://search.iscc.io
# ISCC_C2PA_RESOLVER_SEARCH_INDEX=idp

# Tuning (defaults shown).
# ISCC_C2PA_RESOLVER_SEARCH_TIMEOUT=5.0
# ISCC_C2PA_RESOLVER_GATEWAY_TIMEOUT=3.0
# ISCC_C2PA_RESOLVER_GATEWAY_CONCURRENCY=16
# ISCC_C2PA_RESOLVER_MANIFEST_TIMEOUT=10.0
